# Salin file ini ke .env untuk pengembangan lokal (vercel dev),
# lalu isi nilai sebenarnya di Vercel Project Settings > Environment Variables
# untuk deployment. Jangan pernah commit file .env yang sudah terisi.

# Dari https://developer.spotify.com/dashboard -> Create app
# (redirect URI boleh diisi bebas, misal http://localhost:3000, karena
# aplikasi ini hanya memakai Client Credentials Flow untuk data publik)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dari https://console.cloud.google.com -> aktifkan "YouTube Data API v3"
# -> Credentials -> Create API key (sebaiknya dibatasi ke API ini saja)
YOUTUBE_API_KEY=
